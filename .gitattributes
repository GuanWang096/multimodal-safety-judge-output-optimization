.gitattributes text eol=lf
.gitignore text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.js text eol=lf
*.go text eol=lf
*.mod text eol=lf
*.sum text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.txt text eol=lf
Dockerfile* text eol=lf

# Frozen artifacts are byte-sensitive; never rewrite their line endings.
*.json -text
*.jsonl -text
*.csv -text

*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
